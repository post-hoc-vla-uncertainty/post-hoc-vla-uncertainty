diff --git a/src/lerobot/utils/gpu_utils.py b/src/lerobot/utils/gpu_utils.py
new file mode 100644
index 0000000..b3a5dc0
--- /dev/null
+++ b/src/lerobot/utils/gpu_utils.py
@@ -0,0 +1,162 @@
+"""Match NVIDIA CUDA selections to EGL by UUID, never by enumeration position.
+
+EGL enumeration can differ from PCI/nvidia-smi order and ignores CUDA visibility.
+These queries do not initialize CUDA or create any graphics contexts.
+"""
+
+import csv
+import ctypes
+import logging
+import os
+import subprocess
+import time
+import uuid
+from collections.abc import MutableMapping
+
+
+def nvidia_gpu_uuids() -> dict[str, str]:
+    """Resolve numeric selections at startup, tolerating a brief discovery outage."""
+    command = ["nvidia-smi", "--query-gpu=index,uuid", "--format=csv,noheader,nounits"]
+    last_error = None
+    for attempt in range(3):
+        try:
+            output = subprocess.check_output(command, text=True, timeout=10, stderr=subprocess.PIPE)
+            rows = list(csv.reader(output.splitlines()))
+            if not rows or any(len(row) != 2 or not row[0].strip().isdigit()
+                               or not _full_gpu_uuid(row[1].strip()) for row in rows):
+                raise ValueError(f"Invalid GPU inventory: {output.strip()!r}")
+            result = {index.strip(): _full_gpu_uuid(value.strip()) for index, value in rows}
+            if len(result) != len(rows) or len(set(result.values())) != len(rows):
+                raise ValueError("Ambiguous GPU inventory")
+            return result
+        except (subprocess.SubprocessError, OSError, ValueError) as error:
+            last_error = error
+            if attempt < 2:
+                logging.warning("NVIDIA GPU discovery failed; retrying (%s/3): %s", attempt + 1, error)
+                time.sleep(1)
+    details = " ".join(str(value).strip() for value in (
+        last_error, getattr(last_error, "output", ""), getattr(last_error, "stderr", "")
+    ) if value)
+    raise RuntimeError(
+        f"NVIDIA GPU discovery failed after 3 attempts: {details}. "
+        "Check nvidia-smi and GPU access in the launching terminal (a fresh login may be needed "
+        "after group/permission changes). Existing checkpoints are preserved; rerun the same "
+        "command after GPU access recovers. Refusing to choose another GPU."
+    ) from last_error
+
+
+def _full_gpu_uuid(value: str) -> str | None:
+    if not value.lower().startswith("gpu-"):
+        return None
+    try:
+        return "gpu-" + str(uuid.UUID(value[4:]))
+    except ValueError:
+        return None
+
+
+def resolve_cuda_uuids(visible: str, device_order: str) -> list[str]:
+    """Pin all selected GPUs; full UUIDs need no nvidia-smi lookup in children."""
+    selections = [value.strip().lower() for value in visible.split(",")]
+    if not all(selections):
+        raise RuntimeError("Set a nonempty CUDA_VISIBLE_DEVICES list")
+    if any(value.isdigit() for value in selections) and device_order != "PCI_BUS_ID":
+        raise RuntimeError("Numeric GPU selection requires CUDA_DEVICE_ORDER=PCI_BUS_ID")
+    inventory = nvidia_gpu_uuids() if any(not _full_gpu_uuid(value) for value in selections) else {}
+    targets = []
+    for selected in selections:
+        target = _full_gpu_uuid(selected)
+        if target is None and selected.isdigit():
+            target = inventory.get(selected)
+        elif target is None and selected.startswith("gpu-"):
+            matches = [value for value in inventory.values() if value.startswith(selected)]
+            target = matches[0] if len(matches) == 1 else None
+        if target is None:
+            raise RuntimeError(f"Cannot identify selected CUDA GPU {selected!r}; refusing a renderer fallback")
+        targets.append(target)
+    if len(set(targets)) != len(targets):
+        raise RuntimeError("CUDA selections resolve to duplicate GPUs")
+    return targets
+
+
+def egl_gpu_uuids() -> dict[int, str]:
+    """Query NVIDIA EGL_DEVICE_UUID_EXT values without opening a display."""
+    egl = ctypes.CDLL("libEGL.so.1")
+    egl.eglGetProcAddress.argtypes = [ctypes.c_char_p]
+    egl.eglGetProcAddress.restype = ctypes.c_void_p
+
+    def procedure(name, result, *arguments):
+        address = egl.eglGetProcAddress(name.encode())
+        if not address:
+            raise RuntimeError(f"EGL lacks {name}; cannot safely choose the rendering GPU")
+        return ctypes.CFUNCTYPE(result, *arguments)(address)
+
+    query = procedure("eglQueryDevicesEXT", ctypes.c_uint, ctypes.c_int,
+                      ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_int))
+    string = procedure("eglQueryDeviceStringEXT", ctypes.c_char_p, ctypes.c_void_p, ctypes.c_int)
+    binary = procedure("eglQueryDeviceBinaryEXT", ctypes.c_uint, ctypes.c_void_p,
+                       ctypes.c_int, ctypes.c_int, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int))
+    count = ctypes.c_int()
+    if not query(0, None, ctypes.byref(count)):
+        raise RuntimeError("EGL device enumeration failed")
+    devices = (ctypes.c_void_p * count.value)()
+    if not query(count.value, devices, ctypes.byref(count)):
+        raise RuntimeError("EGL device enumeration failed")
+    result = {}
+    for index, device in enumerate(devices[:count.value]):
+        extensions = (string(device, 0x3055) or b"").split()  # EGL_EXTENSIONS
+        if b"EGL_NV_device_cuda" not in extensions:
+            continue
+        if b"EGL_EXT_device_persistent_id" not in extensions:
+            continue
+        value = (ctypes.c_ubyte * 16)()
+        size = ctypes.c_int()
+        if not binary(device, 0x335C, 16, value, ctypes.byref(size)) or size.value != 16:
+            raise RuntimeError(f"Cannot read UUID of NVIDIA EGL device {index}")
+        result[index] = "gpu-" + str(uuid.UUID(bytes=bytes(value)))
+    return result
+
+
+def match_egl_device(visible: str, device_order: str, nvidia: dict[str, str],
+                     egl: dict[int, str]) -> tuple[int, str]:
+    """Render on the first visible CUDA GPU; reject ambiguous or absent matches."""
+    selected = visible.split(",", 1)[0].strip().lower()
+    if selected.isdigit():
+        if device_order != "PCI_BUS_ID":
+            raise RuntimeError("Numeric GPU selection requires CUDA_DEVICE_ORDER=PCI_BUS_ID")
+        target = nvidia.get(selected)
+    elif selected.startswith("gpu-"):
+        matches = [value for value in nvidia.values() if value.lower().startswith(selected)]
+        target = matches[0] if len(matches) == 1 else None
+    else:
+        target = None
+    if target is None:
+        raise RuntimeError(f"Cannot identify selected CUDA GPU {selected!r}; refusing a renderer fallback")
+    matches = [index for index, value in egl.items() if value.lower() == target.lower()]
+    if len(matches) != 1:
+        raise RuntimeError(f"Expected one EGL device for {target}, found {matches}; refusing a renderer fallback")
+    return matches[0], target
+
+
+def configure_egl_for_visible_cuda(env: MutableMapping[str, str] | None = None) -> dict:
+    """Pin CUDA to stable UUIDs and resolve EGL afresh without positional fallback.
+
+    Propagate the resulting CUDA_VISIBLE_DEVICES to workers. Only the initial
+    numeric/prefix selection invokes nvidia-smi; subsequent full-UUID calls do not.
+    EGL enumeration is still checked each time, since its indices can differ.
+    """
+    env = os.environ if env is None else env
+    visible = env.get("CUDA_VISIBLE_DEVICES", "")
+    if not visible:
+        raise RuntimeError("Set CUDA_VISIBLE_DEVICES explicitly before initializing EGL")
+    targets = resolve_cuda_uuids(visible, env.get("CUDA_DEVICE_ORDER", ""))
+    egl = egl_gpu_uuids()
+    inventory = {str(i): value for i, value in enumerate(targets)}
+    matches = [match_egl_device(value, "PCI_BUS_ID", inventory, egl) for value in targets]
+    index, device_uuid = matches[0]
+    # Commit only after *every* selected device passed UUID validation. CUDA's
+    # documented UUID spelling uses uppercase GPU-; comparison stays lowercase.
+    env["CUDA_VISIBLE_DEVICES"] = ",".join("GPU-" + value[4:] for value in targets)
+    env["MUJOCO_EGL_DEVICE_ID"] = str(index)
+    env["VLA_EGL_GPU_UUID"] = device_uuid
+    return {"requested_cuda_visible_devices": visible, "cuda_visible_devices": env["CUDA_VISIBLE_DEVICES"],
+            "egl_device_index": index, "gpu_uuid": device_uuid}
